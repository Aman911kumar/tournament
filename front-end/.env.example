## =========================
## Battle4Arena Frontend Public Env (.env.example)
## =========================
## Most public defaults live in:
##   front-end/src/config/project.config.ts
##
## Frontend env variables are public after build. Never put secrets here.

## --- Optional API Overrides ---
## Local defaults are already configured.
# VITE_API_BASE_URL="http://localhost:3000/api/v1"
# VITE_FAST_API_BASE_URL="https://api.battle4arena.fun/api/v1"
# VITE_REALTIME_API_BASE_URL="https://realtime.battle4arena.fun/api/v1"

## --- Optional App/OAuth Public IDs ---
VITE_APP_DEEPLINK_SCHEME="battle4arena"
VITE_GOOGLE_CLIENT_ID=""
VITE_FACEBOOK_APP_ID=""
VITE_FACEBOOK_GRAPH_VERSION="v25.0"
VITE_CLERK_PUBLISHABLE_KEY=""

## --- Optional Debug / Performance Overrides ---
# VITE_API_PERF_LOGS=false
# VITE_API_TIMEOUT_MS=45000
# VITE_API_SLOW_REQUEST_MS=2500
# VITE_REALTIME_WAKEUP_COOLDOWN_MS=120000
# VITE_SHOW_API_ROUTES_IN_TOAST=false

## --- Optional Voice / WebRTC ---
## Comma-separated STUN/TURN URLs or a JSON RTCIceServer array.
# VITE_VOICE_ICE_SERVERS=""
