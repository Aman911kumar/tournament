## =========================
## Battle4Arena Frontend (.env.example)
## =========================

## --- API Routing ---
# Local development:
VITE_API_BASE_URL="http://localhost:3000/api/v1"
VITE_FAST_API_BASE_URL="http://localhost:3000/api/v1"
VITE_REALTIME_API_BASE_URL="http://localhost:3000/api/v1"

# Production:
# VITE_FAST_API_BASE_URL="https://api.battle4arena.fun/api/v1"
# VITE_REALTIME_API_BASE_URL="https://realtime.battle4arena.fun/api/v1"

# Cooldown for silent Render wakeup pings.
VITE_REALTIME_WAKEUP_COOLDOWN_MS=120000

## --- API Debug / Performance ---
VITE_API_PERF_LOGS=false
# VITE_API_TIMEOUT_MS=45000
# VITE_API_SLOW_REQUEST_MS=2500

## --- OAuth / Capacitor Deep Links ---
VITE_APP_DEEPLINK_SCHEME="battle4arena"

## --- Google OAuth ---
VITE_GOOGLE_CLIENT_ID=""

## --- Facebook OAuth ---
VITE_FACEBOOK_APP_ID=""
VITE_FACEBOOK_GRAPH_VERSION="v25.0"

## --- Clerk (optional) ---
VITE_CLERK_PUBLISHABLE_KEY=""
