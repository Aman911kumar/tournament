## =========================
## Battle4Arena Backend (.env.example)
## =========================

## --- Server Runtime ---
PORT=3000
NODE_ENV="development"

# Local defaults:
SERVER_ROLE="realtime"
SERVER_PLATFORM="local"
ENABLE_REALTIME=true
ENABLE_BACKGROUND_WORKERS=true

# Vercel production env:
# SERVER_ROLE="fast"
# SERVER_PLATFORM="vercel"
# ENABLE_REALTIME=false
# ENABLE_BACKGROUND_WORKERS=false

# Render production env:
# SERVER_ROLE="realtime"
# SERVER_PLATFORM="render"
# ENABLE_REALTIME=true
# ENABLE_BACKGROUND_WORKERS=true

## --- Public URLs / CORS ---
CORS_ORIGIN="http://localhost:8080,https://battle4arena.fun,https://battle4arena.vercel.app"
APP_PUBLIC_URL="https://battle4arena.fun"
API_PUBLIC_URL="http://localhost:3000"
FAST_API_PUBLIC_URL="https://api.battle4arena.fun/api/v1"
REALTIME_API_PUBLIC_URL="https://realtime.battle4arena.fun/api/v1"

## --- Database ---
DB_CLUSTER_NAME=""
MONGODB_URI=""
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_TIME_MS=60000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000

## --- Auth / JWT ---
ACCESS_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRY="1d"
REFRESH_TOKEN_SECRET=""
REFRESH_TOKEN_EXPIRY="10d"
AUTH_USER_CACHE_TTL_MS=10000
AUTH_USER_CACHE_MAX=1000

## --- OAuth: Google / Facebook ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_GRAPH_VERSION="v25.0"

APP_DEEPLINK_SCHEME="battle4arena"
OAUTH_ALLOWED_RETURN_ORIGINS="http://localhost:8080,https://battle4arena.fun,https://battle4arena.vercel.app"
OAUTH_ALLOWED_RETURN_SCHEMES="battle4arena"
OAUTH_LOGIN_CODE_TTL_MS=300000

## --- Email Ownership / Cross-Runtime Dispatch ---
# Vercel/fast sends email. Render/realtime delegates email to Vercel.
EMAIL_DELEGATE_TO_FAST_API=true
EMAIL_FAST_API_URL="https://api.battle4arena.fun/api/v1"
INTERNAL_EMAIL_SECRET=""

# Vercel:
# ENABLE_EMAIL_DISPATCH=true
# EMAIL_SEND_INLINE=true
# EMAIL_FIRE_AND_FORGET=false
# EMAIL_QUEUE_ENABLED=false

# Render:
# ENABLE_EMAIL_DISPATCH=false
# EMAIL_ALLOW_LOCAL_SEND=false

ENABLE_EMAIL_DISPATCH=true
EMAIL_ALLOW_LOCAL_SEND=false
EMAIL_FORCE_QUEUE=false
EMAIL_DELEGATE_TIMEOUT_MS=15000

## --- Email Sender ---
EMAIL_FROM="Battle4Arena <hello@battle4arena.fun>"
EMAIL_PROVIDER_ORDER="hostinger,sendplus"

# Legacy SMTP compatibility
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""

# Hostinger SMTP
HOSTINGER_SMTP_HOST="smtp.hostinger.com"
HOSTINGER_SMTP_PORT="465"
HOSTINGER_SMTP_SECURE=true
HOSTINGER_SMTP_USER=""
HOSTINGER_SMTP_PASS=""

# SendPlus SMTP
SENDPLUS_SMTP_HOST=""
SENDPLUS_SMTP_PORT="465"
SENDPLUS_SMTP_SECURE=true
SENDPLUS_SMTP_USER=""
SENDPLUS_SMTP_PASS=""

## --- Email Queue / Retry ---
EMAIL_SEND_INLINE=true
EMAIL_FIRE_AND_FORGET=false
EMAIL_QUEUE_ENABLED=false
EMAIL_QUEUE_REDIS_URL=""
EMAIL_QUEUE_ENCRYPTION_KEY=""
EMAIL_QUEUE_REQUIRE_ENCRYPTION=false
EMAIL_WORKER_ENABLED=false
EMAIL_LOG_TO_DB=false
EMAIL_MAX_RETRIES=4
EMAIL_RETRY_DELAY_MS=1500
EMAIL_HEALTH_TTL_MS=30000
EMAIL_LOG_PROVIDER_RESULT=false

## --- Password Reset / OTP Security ---
PASSWORD_RESET_OTP_EXPIRY_MINUTES=5
PASSWORD_RESET_RESEND_COOLDOWN_MINUTES=5
PASSWORD_RESET_LINK_EXPIRY_DAYS=4
PASSWORD_RESET_RESEND_WINDOW_MINUTES=60
PASSWORD_RESET_MAX_RESENDS=5
PASSWORD_RESET_MAX_VERIFY_ATTEMPTS=5
PASSWORD_RESET_GRANT_EXPIRY_MINUTES=15

## --- Rate Limits ---
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=25
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_WALLET_WINDOW_MS=600000
RATE_LIMIT_WALLET_MAX=30
RATE_LIMIT_CHAT_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=90
RATE_LIMIT_REPORT_WINDOW_MS=600000
RATE_LIMIT_REPORT_MAX=8
RATE_LIMIT_MODERATION_WINDOW_MS=600000
RATE_LIMIT_MODERATION_MAX=60
INTERNAL_EMAIL_RATE_LIMIT_WINDOW_MS=60000
INTERNAL_EMAIL_RATE_LIMIT_MAX=120

## --- Socket.IO / Realtime ---
REDIS_URL=""
SOCKET_RATE_LIMIT_WINDOW_MS=60000
SOCKET_RATE_LIMIT_MAX=60
ADMIN_MONITORING_PUSH_MS=10000

## --- Performance / Monitoring ---
SLOW_API_LOG_MS=1500
LOG_SLOW_API=true

## --- Uploads ---
UPLOAD_DIR="uploads"
CHAT_UPLOAD_MAX_BYTES=5242880
CHAT_UPLOAD_MAX_SIZE="5mb"
CHAT_STORAGE_PROVIDER="telestore"
CHAT_STORAGE_LOCAL_FALLBACK=false

## --- TeleStore Media Storage ---
# Keep API secret server-side only. Never add it to frontend env files.
TELESTORE_API_BASE_URL=""
TELESTORE_PUBLIC_BASE_URL=""
TELESTORE_API_KEY=""
TELESTORE_API_SECRET=""
TELESTORE_CHAT_ROOT_FOLDER_NAME="Battle4Arena Live Chat"
TELESTORE_CHAT_VISIBILITY="public"
TELESTORE_TIMEOUT_MS=20000

## --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

## --- Wallet / Platform Fees ---
PLATFORM_FEE_DEPOSIT_PERCENT=2
PLATFORM_FEE_WITHDRAW_PERCENT=2
PLATFORM_FEE_TRANSFER_PERCENT=0
PLATFORM_FEE_WALLET_TRANSFER_PERCENT=0
PLATFORM_FEE_ORGANIZER_EARNING_PERCENT=0
PLATFORM_FEE_REFUND_PERCENT=0
PLATFORM_FEE_TOURNAMENT_ENTRY_PERCENT=2
PLATFORM_FEE_WINNING_PERCENT=0
PLATFORM_FEE_BONUS_PERCENT=0

## --- Push Notifications (Web Push / VAPID) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@battle4arena.fun"

## --- Third-Party / Optional ---
RAPIDAPI_KEY=""
RESEND_API_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
