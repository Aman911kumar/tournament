## =========================
## Battle4Arena Backend Secrets (.env.example)
## =========================
## Most non-secret settings live in:
##   back-end/config/project.config.js
##
## Use this file for secrets, credentials, and deployment-only overrides.
## Do not commit real values.

## --- Runtime Override (optional) ---
## Local defaults are already in config/project.config.js.
# NODE_ENV="development"
# SERVER_ROLE="realtime"
# SERVER_PLATFORM="local"

## Vercel fast API:
# SERVER_ROLE="fast"
# SERVER_PLATFORM="vercel"
# ENABLE_REALTIME=false
# ENABLE_BACKGROUND_WORKERS=false
# EMAIL_DELEGATE_TO_FAST_API=false
# EMAIL_SEND_INLINE=true

## Render realtime API:
# SERVER_ROLE="realtime"
# SERVER_PLATFORM="render"
# ENABLE_REALTIME=true
# ENABLE_BACKGROUND_WORKERS=true
# ENABLE_EMAIL_DISPATCH=false
# EMAIL_DELEGATE_TO_FAST_API=true

## --- Database ---
MONGODB_URI=""

## --- Auth / JWT ---
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""

## --- Internal Service Auth ---
## Same value on Vercel and Render when Render delegates emails to Vercel.
INTERNAL_EMAIL_SECRET=""

## --- OAuth Secrets ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

## --- Payments ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

## --- Email Credentials ---
SMTP_USER=""
SMTP_PASS=""
HOSTINGER_SMTP_USER=""
HOSTINGER_SMTP_PASS=""
SENDPLUS_SMTP_USER=""
SENDPLUS_SMTP_PASS=""

## --- Email Queue / Redis (optional) ---
REDIS_URL=""
EMAIL_QUEUE_REDIS_URL=""
EMAIL_QUEUE_ENCRYPTION_KEY=""

## --- TeleStore Media Storage ---
TELESTORE_API_KEY=""
TELESTORE_API_SECRET=""

## --- Push Notifications ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

## --- Third-party Keys ---
RAPIDAPI_KEY=""
RESEND_API_KEY=""
CLERK_SECRET_KEY=""

## --- Optional Public/Deployment Overrides ---
## Only set these when a deployed environment differs from project.config.js.
# CORS_ORIGIN="https://battle4arena.fun,https://battle4arena.vercel.app"
# APP_PUBLIC_URL="https://battle4arena.fun"
# API_PUBLIC_URL="https://api.battle4arena.fun"
# FAST_API_PUBLIC_URL="https://api.battle4arena.fun/api/v1"
# REALTIME_API_PUBLIC_URL="https://realtime.battle4arena.fun/api/v1"
# TELESTORE_API_BASE_URL="https://storageapi.battle4arena.fun/api/v1"
# TELESTORE_PUBLIC_BASE_URL="https://storageapi.battle4arena.fun"
